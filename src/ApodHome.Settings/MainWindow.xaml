<Window x:Class="ApodHome.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APOD Home" Width="620" Height="580" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Astronomy Picture of the Day" FontSize="24" FontWeight="SemiBold" />
      <TextBlock x:Name="StatusText" Margin="0,6,0,16" TextWrapping="Wrap" Foreground="DimGray" />
    </StackPanel>
    <Border Grid.Row="1" Background="#101820" CornerRadius="8" Padding="8">
      <Image x:Name="PreviewImage" Stretch="Uniform" />
    </Border>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="UpdatedText" Margin="0,4,0,12" Foreground="DimGray" />
      <WrapPanel>
        <Button x:Name="RefreshDesktopButton" Click="RefreshDesktop_Click" Padding="14,7" Margin="0,0,8,0">Refresh desktop</Button>
        <Button x:Name="RefreshAllButton" Click="RefreshAll_Click" Padding="14,7" Margin="0,0,8,0">Refresh desktop and lock screen</Button>
        <Button x:Name="OpenSourceButton" Click="OpenSource_Click" Padding="14,7">Open APOD</Button>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
